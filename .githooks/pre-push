#!/bin/sh
# Constitution Principle I: nothing reaches main except through a pull request.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push to '${remote_ref#refs/heads/}'. Push a feature branch and open a pull request instead." >&2
      echo "  (Principle I in .specify/memory/constitution.md)" >&2
      exit 1
      ;;
  esac
done
exit 0
