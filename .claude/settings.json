{
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "Bash(lsof *)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl http://localhost*)"
    ],
    "deny": [
      "Bash(brew *)",
      "Bash(sudo *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(bun add -g *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push origin main*)",
      "Write(**/IMPLEMENTATION_*.md)",
      "Write(**/*SUMMARY*.md)",
      "Write(**/*STOPPED*.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-commit.sh"
          }
        ]
      }
    ]
  }
}
